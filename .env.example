# Copie este arquivo para .env e preencha os valores.
# scripts/apply-to-cursor.sh troca cada ${VAR} do mcp.json pelo valor daqui.
# GitMCP, DeepWiki, Postman, Stripe, Meta Ads, Meta Instagram, Azure, GitHub e Azure DevOps não usam variável.

ASAAS_API_KEY=
JIRA_PERSONAL_TOKEN=
RENDER_API_KEY=
N8N_API_URL=
N8N_API_KEY=

# Strix (CLI local). Carregue com:
#   source scripts/load-env.sh
#   ./scripts/with-env.sh <comando>
#   ./scripts/strix-env-check.sh
# Runs na pasta do chamado (não na raiz):
#   ./scripts/strix-in-chamado.sh <pasta-do-chamado> -- -n -t <alvo> --scan-mode quick
# O apply-to-cursor.sh também faz source do .env (só para substituir ${VAR} no mcp.json).
OPENAI_API_KEY=
LLM_API_KEY=
STRIX_LLM=openai/gpt-5.4
